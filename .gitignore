# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 이미지 파이프라인 산출물 (prebuild/predev 에서 재생성)
/public/derived/**

# 단, ffmpeg 산출물(mp4 · poster)은 커밋한다.
# 배포 CI(Cloudflare Pages)에 ffmpeg 가 없어서 빌드가 거기서 멈춘다.
# 원본이 안 바뀌면 결과도 안 바뀌므로 매 빌드마다 만들 이유도 없다.
# 원본을 갈아끼웠을 때만 `npm run media` 로 다시 만들어 함께 커밋한다.
# (sharp 산출물인 avif · webp 는 계속 무시 — sharp 는 npm 패키지라 어디서든 돈다.)
!/public/derived/**/
!/public/derived/**/*.mp4
!/public/derived/**/*-poster.jpg
/src/data/generated/
/public/fonts/
/src/styles/pretendard.generated.css

# font-charset.lock.json 은 이그노어하지 않는다 — 빌드 입력(락파일)이다.
# 없으면 clone 직후 첫 빌드가 반드시 두 번 돌아야 한다.

{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "images": "node scripts/build-images.mjs",
    "prebuild": "node scripts/build-fonts.mjs && node scripts/build-images.mjs",
    "predev": "node scripts/build-fonts.mjs && node scripts/build-images.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "serve": "node scripts/serve-static.mjs out 8766",
    "lighthouse": "lighthouse http://127.0.0.1:8766/ --chrome-flags='--headless=new --disable-gpu' --view",
    "postbuild": "node scripts/build-fonts.mjs --from-build",
    "verify:fonts": "node scripts/verify-fonts.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "lighthouse": "^13.4.1",
    "pretendard": "^1.3.9",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
